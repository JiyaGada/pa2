#include "cache.h"

#define maxRRPV 3
#define L2C_DUELING_SET 32
#define IRRIP_THRESHOLD 0.25

uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t is_instr[L2C_SET][L2C_WAY];

// dynamic irrip (dirrip)
uint32_t instr_access_duel_sets;
uint32_t data_access_duel_sets;
uint32_t instr_misses_duel_sets;
uint32_t data_misses_duel_sets;

bool is_irrip() {
if  (((instr_access_duel_sets + instr_misses_duel_sets) /
    double(instr_access_duel_sets + instr_misses_duel_sets + data_access_duel_sets + data_misses_duel_sets)) >
    IRRIP_THRESHOLD) {
        return true;
    }
    return false;
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize DIRRIP state for L2C" << endl;

    instr_access_duel_sets=0;
    data_access_duel_sets=0;
    instr_misses_duel_sets=0;
    data_misses_duel_sets=0;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            is_instr[i][j] = 0;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{

    // RRIP set always does RRIP.
    if (set >= 0 && set < L2C_DUELING_SET) {
        while (1)
                {
                    for (int i=0; i<L2C_WAY; i++)
                        if (l2_rrpv[set][i] == maxRRPV)
                            return i;

                    for (int i=0; i<L2C_WAY; i++)
                        l2_rrpv[set][i]++;
                }
    }
    // else remaining check for stats - here it supported irrip
    else if (is_irrip()) {
     // look for the maxRRPV line
        while (1)
        {
        // I-RRIP v2: try removing data blocks first.
            for (int i=0; i<L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV && is_instr[set][i] == 0)
                    return i;

            for (int i=0; i<L2C_WAY; i++)
                    if (l2_rrpv[set][i] == maxRRPV && is_instr[set][i] == 1)
                        return i;

            for (int i=0; i<L2C_WAY; i++)
                l2_rrpv[set][i]++;
        }
    }
    // here it supported rrip
    else {
     // look for the maxRRPV line
        while (1)
        {
            for (int i=0; i<L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV)
                    return i;

            for (int i=0; i<L2C_WAY; i++)
                l2_rrpv[set][i]++;
        }
    }


    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    // update stats if dueling set
    if (set >= 0 && set < L2C_DUELING_SET) {
         instr_access_duel_sets += isInstruction ? 1 : 0;
         data_access_duel_sets += isInstruction? 0 : 1;
    }

    // update stats if dueling set
    if (hit) {
            l2_rrpv[set][way] = 0;
    }
    else if (set >= 0 && set < L2C_DUELING_SET) {
         instr_misses_duel_sets += isInstruction ? 1 : 0;
         data_misses_duel_sets += isInstruction? 0 : 1;
    }

    if (!hit) {
        // RRIP leader sets must use RRIP insertion as well as RRIP eviction.
        if (isInstruction) {
            bool rrip_leader = set < L2C_DUELING_SET;
            l2_rrpv[set][way] = (!rrip_leader && is_irrip())
                ? maxRRPV - 2 : maxRRPV - 1;
            is_instr[set][way] = 1;
        }
        else {
            l2_rrpv[set][way] = maxRRPV-1;  // data - insert with RRPV2
            is_instr[set][way] = 0;
        }
    }

}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "L2C instr_access_duel_sets: " << instr_access_duel_sets
         << "\nL2C data_access_duel_sets: " << data_access_duel_sets
         << "\nL2C instr_misses_duel_sets: " << instr_misses_duel_sets
         << "\nL2C data_misses_duel_sets: " << data_misses_duel_sets
         << "\nL2C I-RRIP selected: " << (is_irrip() ? "yes" : "no") << "\n";
}
