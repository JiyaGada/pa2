#include "cache.h"
#include <cstdlib>

#define maxRRPV 3

uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t is_instr[L2C_SET][L2C_WAY];

uint32_t leader_sets = 32;
uint32_t instr_insert_pos = 1;
double irrip_threshold = 0.20;
bool static_irrip = false;

uint64_t instr_access_duel_sets, data_access_duel_sets;
uint64_t instr_misses_duel_sets, data_misses_duel_sets;

bool is_irrip()
{
    if (static_irrip)
        return true;

    uint64_t numerator = instr_access_duel_sets + instr_misses_duel_sets;
    uint64_t denominator = numerator + data_access_duel_sets + data_misses_duel_sets;
    return denominator != 0 && (double(numerator) / double(denominator)) > irrip_threshold;
}

void CACHE::l2c_initialize_replacement()
{
    const char *value = std::getenv("IRRIP_SWEEP_LEADERS");
    if (value)
        leader_sets = std::min<uint32_t>(std::atoi(value), L2C_SET);

    value = std::getenv("IRRIP_SWEEP_THRESHOLD");
    if (value)
        irrip_threshold = std::atof(value);

    value = std::getenv("IRRIP_SWEEP_INSERT_POS");
    if (value)
        instr_insert_pos = std::min<uint32_t>(std::atoi(value), 1);

    value = std::getenv("IRRIP_SWEEP_MODE");
    static_irrip = value && std::string(value) == "static";

    instr_access_duel_sets = data_access_duel_sets = 0;
    instr_misses_duel_sets = data_misses_duel_sets = 0;

    cout << "Initialize I-RRIP sweep policy: mode=" << (static_irrip ? "static" : "dynamic")
         << " leaders=" << leader_sets << " threshold=" << irrip_threshold
         << " instruction_insert_RRPV=" << instr_insert_pos << endl;

    for (int set = 0; set < L2C_SET; ++set) {
        for (int way = 0; way < L2C_WAY; ++way) {
            l2_rrpv[set][way] = maxRRPV;
            is_instr[set][way] = 0;
        }
    }
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set,
                                const BLOCK *current_set, uint64_t ip,
                                uint64_t full_addr, uint32_t type)
{
    bool rrip_leader = !static_irrip && set < leader_sets;
    bool irrip = !rrip_leader && is_irrip();

    while (1) {
        if (irrip) {
            for (int way = 0; way < L2C_WAY; ++way)
                if (l2_rrpv[set][way] == maxRRPV && !is_instr[set][way])
                    return way;
        }

        for (int way = 0; way < L2C_WAY; ++way)
            if (l2_rrpv[set][way] == maxRRPV)
                return way;

        for (int way = 0; way < L2C_WAY; ++way)
            ++l2_rrpv[set][way];
    }
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set,
                                         uint32_t way, uint64_t full_addr,
                                         uint64_t ip, uint64_t victim_addr,
                                         uint32_t type, uint8_t hit,
                                         uint8_t isInstruction)
{
    if (!static_irrip && set < leader_sets) {
        instr_access_duel_sets += isInstruction ? 1 : 0;
        data_access_duel_sets += isInstruction ? 0 : 1;
        if (!hit) {
            instr_misses_duel_sets += isInstruction ? 1 : 0;
            data_misses_duel_sets += isInstruction ? 0 : 1;
        }
    }

    if (hit) {
        l2_rrpv[set][way] = 0;
        return;
    }

    bool rrip_leader = !static_irrip && set < leader_sets;
    bool use_irrip = static_irrip || (!rrip_leader && is_irrip());

    if (isInstruction) {
        l2_rrpv[set][way] = use_irrip ? instr_insert_pos : maxRRPV - 1;
        is_instr[set][way] = 1;
    } else {
        l2_rrpv[set][way] = maxRRPV - 1;
        is_instr[set][way] = 0;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    uint64_t numerator = instr_access_duel_sets + instr_misses_duel_sets;
    uint64_t denominator = numerator + data_access_duel_sets + data_misses_duel_sets;
    double share = denominator ? double(numerator) / double(denominator) : 0.0;

    cout << "L2C sweep leaders=" << leader_sets << " threshold=" << irrip_threshold
         << " instruction_insert_RRPV=" << instr_insert_pos
         << " instruction_share=" << share << " I-RRIP_selected="
         << (is_irrip() ? "yes" : "no")
         << " instruction_accesses/misses=" << instr_access_duel_sets << "/"
         << instr_misses_duel_sets << " data_accesses/misses=" << data_access_duel_sets
         << "/" << data_misses_duel_sets << "\n";
}
